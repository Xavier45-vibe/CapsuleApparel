<article class="post">
  <header class="post-header">
    <p class="eyebrow">{{post.category}} · {{post.readTime}} MIN READ</p>
    <h1>{{post.title}}</h1>
    <p class="post-date">{{post.date}}</p>
  </header>
  <img class="post-image" src="{{post.image}}" alt="{{post.title}}" />
  <div class="post-body">
    {{#each post.body}}<p>{{this}}</p>{{/each}}
    <a class="button button-dark" href="/products">Shop the collection <span>↗</span></a>
  </div>
</article>

<section class="journal-section section-pad">
  <div class="section-heading"><div><p class="eyebrow">KEEP READING</p><h2>More <em>stories.</em></h2></div><a class="text-link" href="/blog">All stories <span>↗</span></a></div>
  <div class="journal-grid two">
    {{#each more}}{{> post_card}}{{/each}}
  </div>
</section>
