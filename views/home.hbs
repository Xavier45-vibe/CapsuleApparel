<section class="hero" aria-label="New season collection">
  <img class="hero-image" src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=2200&q=85" alt="Model wearing understated, contemporary menswear" />
  <div class="hero-shade"></div>
  <div class="hero-copy">
    <p class="eyebrow light">THE EVERYDAY EDIT · ISSUE 01</p>
    <h1>Wear well.<br /><em>Live lightly.</em></h1>
    <p>Sustainable menswear, made with expert craftsmanship. Better days, made to last.</p>
    <a class="button button-light" href="/products">Shop the collection <span>↗</span></a>
  </div>
  <div class="hero-note">A considered wardrobe<br />for the long run.</div>
</section>

<section class="intro section-pad">
  <p class="eyebrow">LESS, BUT BETTER</p>
  <h2>Pieces to live in.<br /><em>Not just to wear.</em></h2>
  <p class="intro-copy">The things we keep close are the things that feel right. We make thoughtfully designed menswear from better materials, for the everyday moments that make a life.</p>
  <a class="text-link" href="/about">Get to know us <span>↗</span></a>
  <span class="intro-stamp">MADE TO<br />MEAN MORE</span>
</section>

<section class="shop-section section-pad" id="shop">
  <div class="section-heading">
    <div><p class="eyebrow">THE GOOD STUFF</p><h2>Everyday, <em>elevated.</em></h2></div>
    <a class="text-link" href="/products">Shop all pieces <span>↗</span></a>
  </div>
  <div class="product-grid">
    {{#each featured}}{{> product_card}}{{/each}}
  </div>
</section>

<section class="values-band">
  <div class="values-photo"><img src="https://images.unsplash.com/photo-1523398002811-999ca8dec234?auto=format&fit=crop&w=1100&q=80" alt="Details of well-made, timeless clothing" loading="lazy" /></div>
  <div class="values-copy">
    <p class="eyebrow light">A BETTER KIND OF EVERYDAY</p>
    <h2>Good for your<br /><em>closet. Lighter<br />on the planet.</em></h2>
    <p>We believe the most sustainable thing you can wear is the thing you’ll love for a long, long time. So we start with responsible materials, partner with skilled makers, and sweat the little details.</p>
    <a class="button button-outline" href="/about">Our way of doing things <span>↗</span></a>
  </div>
  <div class="values-index">THOUGHTFUL BY DESIGN · ONLINE ONLY</div>
</section>

{{> team}}

<section class="journal-section section-pad">
  <div class="section-heading">
    <div><p class="eyebrow">NOTES FROM THE GOOD LIFE</p><h2>The <em>journal.</em></h2></div>
    <a class="text-link" href="/blog">All stories <span>↗</span></a>
  </div>
  <div class="journal-grid">
    {{#each posts}}{{> post_card}}{{/each}}
  </div>
</section>

<section class="cta-band">
  <p class="eyebrow light">READY WHEN YOU ARE</p>
  <h2>Find the piece you’ll <em>reach for every day.</em></h2>
  <a class="button button-light" href="/products">Shop now <span>↗</span></a>
</section>

{{> newsletter}}
