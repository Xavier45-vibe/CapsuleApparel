<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#e9e8e3" />
    <meta name="description" content="Thoughtfully made, sustainable menswear for the everyday. Considered essentials from Capsule Apparel." />
    <title>{{title}} — Capsule Apparel</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,500;1,600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/styles.css" />
    <script src="/app.js" defer></script>
  </head>
  <body id="top">
    <div class="announcement">A little less, a lot better. Complimentary shipping on orders over $150.</div>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Capsule Apparel home">capsule<span>®</span><small>APPAREL FOR EVERYDAY</small></a>
      <button class="menu-toggle" aria-label="Open navigation" aria-expanded="false">☰</button>
      <nav class="main-nav" aria-label="Main navigation">
        <a href="/products">Shop</a><a href="/about">Our story</a><a href="/blog">Journal</a>
      </nav>
      <button class="bag-button" aria-label="Shopping bag, 0 items">Bag <span class="bag-count">0</span></button>
    </header>

    <main>
      {{{body}}}
    </main>

    <footer class="site-footer">
      <div class="footer-top">
        <a class="wordmark footer-wordmark" href="/">capsule<span>®</span><small>APPAREL FOR EVERYDAY</small></a>
        <p>Considered by nature.<br />Made for wherever life takes you.</p>
        <nav aria-label="Footer navigation"><a href="/products">Shop</a><a href="/about">Our story</a><a href="/blog">Journal</a><a href="mailto:hello@capsuleapparel.com">Get in touch</a></nav>
      </div>
      <div class="footer-bottom"><span>© 2025 Capsule Apparel. Made with care.</span><span>Better things, fewer things.</span><a href="#top">Back to top ↑</a></div>
    </footer>
    <div class="toast" role="status" aria-live="polite"></div>
  </body>
</html>
